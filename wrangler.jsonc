{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glush-worlds",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "WorldRoom" },
    { "name": "GATE", "class_name": "CreateGate" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldRoom", "CreateGate"] }],
  "vars": { "ALLOWED_ORIGINS": "https://glush-game.vercel.app,https://glush.varantsov.ru,http://127.0.0.1:4175,http://localhost:4175" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
